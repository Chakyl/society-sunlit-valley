  "portable_blueprints.gui.tablet.app.configuration.client.defaultHologramTransparency": "默认全息图透明度值 \n(默认: 0 | 最小: 0 | 最大: 100)",
  "portable_blueprints.gui.tablet.app.configuration.client.scannerAreaColor": "扫描仪选取区域颜色",
