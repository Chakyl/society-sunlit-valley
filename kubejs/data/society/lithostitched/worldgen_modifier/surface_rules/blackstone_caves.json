{
  "type": "lithostitched:add_surface_rule",
  "levels": ["society:skull_cavern"],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": ["society:blackstone_caves"]
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "max_threshold": 0.05,
            "min_threshold": -0.25,
            "noise": "minecraft:surface"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "society:skull_crimsite"
            }
          }
        },
        {
          "type": "minecraft:block",
          "result_state": {
            "Name": "society:skull_scoria"
          }
        }
      ]
    }
  }
}
