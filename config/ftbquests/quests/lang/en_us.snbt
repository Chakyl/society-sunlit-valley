	task.3D497F4CF396A37A.title: "Complete the Abandoned Farm"
	task.3E0453D9C60A9B8C.title: "Any Diamond armor"
	task.3E8C2AD5FDF6B94F.title: "Any Bobber"
	task.3EF5A9EA750FC64D.title: "Any Furniture Catalog"
