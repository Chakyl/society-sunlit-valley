	task.37BEA915F4C1B7B2.title: "Any copycat block"
	task.380838F0BF3B7E91.title: "I will nurture Slimes"
	task.38A2FC9B0D264BD2.title: "Any advanced fertilizer"
	task.38C343FDC4F440C9.title: "Collect all dishes"
	task.38C738638838D769.title: "Complete the Crafts Room"
	task.3A37B10C5BC6FC29.title: "Gem collection complete"
	task.3A3C41B464166327.title: "Choice Item"
	task.3AD3A245C817EDF9.title: "Bake all Baked goods"
	task.3C3B7B201B44B8AD.title: "Any Crystal of Regret"
